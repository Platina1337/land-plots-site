# Адрес сайта для canonical URL и sitemap
SITE_URL=https://example.com

# Необязательно: endpoint Formspree или совместимого сервиса.
# Если оставить пустым, форма подготовит письмо через почтовое приложение.
PUBLIC_FORM_ENDPOINT=

# Необязательно: идентификатор Яндекс.Метрики
PUBLIC_YANDEX_METRIKA_ID=
