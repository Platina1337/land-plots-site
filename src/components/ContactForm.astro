---
import { site } from "../data/site";

interface Props {
  compact?: boolean;
  source?: string;
}

const { compact = false, source = "Сайт" } = Astro.props;
const endpoint = import.meta.env.PUBLIC_FORM_ENDPOINT ?? "";
---

<form
  class:list={["contact-form", { compact }]}
  data-contact-form
  data-endpoint={endpoint}
  data-email={site.email}
>
  <input type="hidden" name="source" value={source} />
  <div class="field">
    <label for={`name-${source}`}>Ваше имя</label>
    <input id={`name-${source}`} name="name" type="text" autocomplete="name" placeholder="Как к вам обращаться" required />
  </div>
  <div class="field">
    <label for={`phone-${source}`}>Телефон</label>
    <input
      id={`phone-${source}`}
      name="phone"
      type="tel"
      autocomplete="tel"
      inputmode="tel"
      placeholder="+7 (___) ___-__-__"
      pattern="[+0-9 ()-]{10,}"
      required
    />
  </div>
  {!compact && (
    <div class="field field-wide">
      <label for={`message-${source}`}>Комментарий <span>необязательно</span></label>
      <textarea id={`message-${source}`} name="message" rows="3" placeholder="Например: интересует участок 10–15 соток"></textarea>
    </div>
  )}
  <label class="consent field-wide">
    <input type="checkbox" name="consent" required />
    <span>
      Я соглашаюсь с <a href="/privacy" target="_blank">политикой обработки персональных данных</a>
    </span>
  </label>
  <button class="button button-primary field-wide" type="submit">
    <span>Отправить заявку</span>
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <path d="m8 5 7 7-7 7" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" />
    </svg>
  </button>
  <p class="form-status field-wide" role="status" aria-live="polite" data-form-status></p>
</form>

<script>
  document.querySelectorAll<HTMLFormElement>("[data-contact-form]").forEach((form) => {
    if (form.dataset.ready) return;
    form.dataset.ready = "true";

    const phone = form.querySelector<HTMLInputElement>('input[name="phone"]');
    phone?.addEventListener("input", () => {
      phone.value = phone.value.replace(/[^\d+() -]/g, "");
    });

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (!form.reportValidity()) return;

      const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      const status = form.querySelector<HTMLElement>("[data-form-status]");
      const endpoint = form.dataset.endpoint;
      const data = new FormData(form);

      if (button) button.disabled = true;
      if (status) status.textContent = "Отправляем…";

      try {
        if (endpoint) {
          const response = await fetch(endpoint, {
            method: "POST",
            body: data,
            headers: { Accept: "application/json" },
          });
          if (!response.ok) throw new Error("Request failed");
          if (status) status.textContent = "Спасибо! Мы свяжемся с вами в ближайшее время.";
          form.reset();
          return;
        }

        const email = form.dataset.email;
        const name = String(data.get("name") ?? "");
        const phoneValue = String(data.get("phone") ?? "");
        const message = String(data.get("message") ?? "");
        const source = String(data.get("source") ?? "Сайт");
        const body = `Имя: ${name}\nТелефон: ${phoneValue}\nИсточник: ${source}\nКомментарий: ${message}`;
        window.location.href = `mailto:${email}?subject=${encodeURIComponent("Заявка с сайта")}&body=${encodeURIComponent(body)}`;
        if (status) status.textContent = "Открылось почтовое приложение. Отправьте подготовленное письмо.";
      } catch {
        if (status) status.textContent = "Не удалось отправить. Позвоните нам по телефону, указанному на сайте.";
      } finally {
        if (button) button.disabled = false;
      }
    });
  });
</script>

<style>
  .contact-form {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }

  .field {
    display: grid;
    gap: 7px;
  }

  .field-wide {
    grid-column: 1 / -1;
  }

  label {
    color: var(--ink);
    font-size: 13px;
    font-weight: 700;
  }

  label span {
    color: var(--muted);
    font-weight: 500;
  }

  input,
  textarea {
    width: 100%;
    border: 1px solid #cad3cb;
    border-radius: 13px;
    background: white;
    color: var(--ink);
    outline: none;
    transition: border-color 0.2s, box-shadow 0.2s;
  }

  input {
    height: 52px;
    padding: 0 16px;
  }

  textarea {
    min-height: 92px;
    padding: 13px 16px;
    resize: vertical;
  }

  input:focus,
  textarea:focus {
    border-color: var(--forest);
    box-shadow: 0 0 0 3px rgba(23, 63, 53, 0.12);
  }

  .consent {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    font-size: 12px;
    font-weight: 500;
  }

  .consent input {
    width: 18px;
    height: 18px;
    flex: 0 0 auto;
    margin: 1px 0 0;
    accent-color: var(--forest);
  }

  .consent a {
    color: var(--forest);
  }

  button svg {
    width: 18px;
  }

  button:disabled {
    opacity: 0.65;
    cursor: wait;
  }

  .form-status {
    min-height: 1.5em;
    margin: -4px 0 0;
    color: var(--forest);
    font-size: 13px;
    font-weight: 600;
  }

  .compact {
    grid-template-columns: 1fr 1fr auto;
    align-items: end;
  }

  .compact .field-wide {
    grid-column: auto;
  }

  .compact .consent,
  .compact .form-status {
    grid-column: 1 / -1;
  }

  .compact button {
    height: 52px;
  }

  @media (max-width: 800px) {
    .contact-form,
    .compact {
      grid-template-columns: 1fr;
    }

    .compact .field-wide,
    .compact .consent,
    .compact .form-status {
      grid-column: 1;
    }
  }
</style>
