---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Земельные участки",
  description = "Продажа земельных участков — информационный сайт",
} = Astro.props;
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <header>
      <nav>
        <a href="/">Главная</a>
        <a href="#plots">Участки</a>
        <a href="#about">О проекте</a>
        <a href="#contacts">Контакты</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer>
      <p>
        Сайт носит информационный характер и не является публичной офертой (ст. 437 ГК РФ).
      </p>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light;
    font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
    line-height: 1.5;
    color: #1a1a1a;
    background: #fafafa;
  }

  * {
    box-sizing: border-box;
  }

  body {
    margin: 0;
  }

  header {
    background: #fff;
    border-bottom: 1px solid #e5e5e5;
    padding: 1rem 1.5rem;
  }

  nav {
    display: flex;
    gap: 1.5rem;
    max-width: 1100px;
    margin: 0 auto;
  }

  nav a {
    color: #2d5016;
    text-decoration: none;
    font-weight: 500;
  }

  main {
    max-width: 1100px;
    margin: 0 auto;
    padding: 2rem 1.5rem;
  }

  footer {
    border-top: 1px solid #e5e5e5;
    padding: 1.5rem;
    text-align: center;
    font-size: 0.875rem;
    color: #666;
  }
</style>
